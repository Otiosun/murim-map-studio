{
  "name": "murim-map-studio",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "24.20.x",
    "pnpm": "11.21.0"
  },
  "scripts": {
    "dev": "turbo dev --parallel",
    "build": "turbo build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --write apps/player/app/page.tsx && git diff -- apps/player/app/page.tsx && git diff --exit-code -- apps/player/app/page.tsx",
    "typecheck": "turbo typecheck",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "node scripts/e2e-not-enabled.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop --no-backup",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema player_api,server_api,world_private,app_private"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "supabase": "2.115.0",
    "turbo": "2.10.12",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  }
}
